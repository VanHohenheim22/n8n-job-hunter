# Copiar a infra/.env y rellenar. infra/.env está en .gitignore.

# Postgres
POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambiar_esto        # generar: openssl rand -hex 24
POSTGRES_DB=n8n                       # base interna de n8n
JOBS_DB=jobs                          # base de ofertas para el estudio de mercado
POSTGRES_PORT=5432                    # solo en 127.0.0.1

# n8n
N8N_VERSION=2.47.7                    # versión fija (probada 2026-11-13); subir a mano
N8N_PORT=5678                         # solo en 127.0.0.1
N8N_ENCRYPTION_KEY=cambiar_esto       # generar: openssl rand -hex 32 (NO perderla: cifra las credenciales)
N8N_API_KEY=                          # n8n → Settings → n8n API → Create API key (para scripts/n8n.sh)
TZ=America/Bogota
TELEGRAM_BOT_TOKEN=                   # @BotFather → /newbot (o /revoke para renovarlo)
TELEGRAM_CHAT_ID=                     # tu chat; se obtiene con getUpdates tras escribirle al bot
GITHUB_API_KEY=                       # token fine-grained de GitHub (Contents + Administration: write) para publicar el portafolio
WEBHOOK_SECRET=                       # openssl rand -hex 32 · tg-poller → n8n (cabecera X-Webhook-Secret)
GEMINI_API_KEY=                       # https://aistudio.google.com/apikey · borradores de aplicación (WF3)
GEMINI_MODEL=gemini-3.5-flash             # modelo Flash (ver modelos: GET /v1beta/models); LLM_BASE_URL opcional para LLM local
